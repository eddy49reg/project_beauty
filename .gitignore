# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/

# Cursor IDE: правила, локальные настройки агента (не в репозиторий)
.cursor/

# ВКР: локальные plain-text выжимки из Word для поиска в IDE (не коммитить)
docs/*-plain.txt

# Локальные venv для скриптов генерации .docx (python-docx и т.д.)
.venv-docx/
.venv-img/

# ВКР: сгенерированные Word и примеры PDF в docs/
docs/**/*.docx
docs/**/*.pdf

# ВКР: текстовые документы плана/спринтов в docs/ (держим только локально)
docs/ВКР*.md

# Локальные заметки фронтенда (конвенции и т.п.)
frontend/docs/

# Production secrets on VPS (never commit)
.env.prod
backend/.env

# Презентация к защите ВКР (генерируется локально, в репо приложения не нужна)
docs/slide*

# Генераторы слайдов презентации (не часть приложения)
scripts/generate_slide*.py

# ВКР: Python — блоки текста, стили, генераторы .docx
scripts/vkr*.py
scripts/generate*vkr*.py
scripts/generate-nir-assembly-docx.py
