/// Важно:
/// - после изменения схемы запускаем миграцию,
///   чтобы изменения применились в реальной БД.
/// - затем запускаем generate, чтобы Prisma обновил типы клиента.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserAppRole {
  USER
  ORGANIZER
  ADMIN
}

enum ChampionshipStatus {
  DRAFT
  REGISTRATION
  JUDGING
  PUBLISHED
  ARCHIVED
}

enum WorkStatus {
  DRAFT
  SUBMITTED
  OVERDUE
}

model User {
  id         Int                      @id @default(autoincrement())
  login      String                   @unique @db.VarChar(50)
  passwordHash String?                @map("password_hash") @db.VarChar(255)
  firstname  String                   @db.VarChar(100)
  surname    String                   @db.VarChar(100)
  phone      String                   @db.VarChar(32)
  tg         String?                  @db.VarChar(100)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  membership ChampionshipMembership[]
  works      Work[]
  judgeScores JudgeScore[]
  appRole    UserAppRole              @default(USER) @map("app_role")

  @@map("users")
}

model Role {
  id         Int                      @id @default(autoincrement())
  code       String                   @unique @db.VarChar(50)
  title      String?                  @db.VarChar(100)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  membership ChampionshipMembership[]

  @@map("roles")
}

model Championship {
  id                  Int                      @id @default(autoincrement())
  title               String                   @db.VarChar(200)
  description         String?
  status              ChampionshipStatus       @default(DRAFT)
  registrationStartAt DateTime                 @map("registration_start_at") @db.Timestamptz(6)
  registrationEndAt   DateTime                 @map("registration_end_at") @db.Timestamptz(6)
  judgingStartAt      DateTime?                @map("judging_start_at") @db.Timestamptz(6)
  judgingEndAt        DateTime?                @map("judging_end_at") @db.Timestamptz(6)
  resultPublishedAt   DateTime?                @map("result_published_at") @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  nominations         Nomination[]
  membership          ChampionshipMembership[]
  works               Work[]

  @@map("championships")
}

model Nomination {
  id             Int                      @id @default(autoincrement())
  championshipId Int                      @map("championship_id")
  title          String                   @db.VarChar(200)
  description    String?
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  championship   Championship             @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  membership     ChampionshipMembership[]
  works          Work[]

  @@unique([championshipId, title], map: "nominations_championship_title_uq")
  @@map("nominations")
}

model ChampionshipMembership {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  championshipId Int          @map("championship_id")
  roleId         Int          @map("role_id")
  nominationId   Int          @map("nomination_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  nomination   Nomination   @relation(fields: [nominationId], references: [id], onDelete: Cascade)

  @@unique([userId, championshipId, nominationId, roleId], map: "membership_user_champ_nom_role_uq")
  @@map("championship_memberships")
}

model Work {
  id             Int        @id @default(autoincrement())
  championshipId Int        @map("championship_id")
  nominationId   Int        @map("nomination_id")
  authorId       Int        @map("author_id")
  title          String     @db.VarChar(200)
  description    String?
  status         WorkStatus @default(DRAFT)
  submittedAt    DateTime?  @map("submitted_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  nomination   Nomination   @relation(fields: [nominationId], references: [id], onDelete: Restrict)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  judgeScores  JudgeScore[]

  @@unique([authorId, nominationId], map: "works_author_nomination_uq")
  @@map("works")
}

model JudgeScore {
  id         Int      @id @default(autoincrement())
  workId     Int      @map("work_id")
  judgeId    Int      @map("judge_id")
  score      Int
  comment    String?
  isFinal    Boolean  @default(false) @map("is_final")
  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  work       Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  judge      User     @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([workId, judgeId], map: "judge_scores_work_judge_uq")
  @@map("judge_scores")
}

